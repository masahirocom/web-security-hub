# Copy this file to sites/<your-site-id>/.env (gitignored) and fill in real values.
# Never commit a filled-in .env file.

# Application login credentials (used when site.config.json login.* selectors are set)
LOGIN_USER=changeme
LOGIN_PASS=changeme

# HTTP Basic-Auth credentials (used when site.config.json basicAuth.enabled=true)
BASIC_USER=changeme
BASIC_PASS=changeme
